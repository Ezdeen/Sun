{
  "name": "@waste/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/cli.ts seed",
    "db:seed:demo": "tsx src/cli.ts seed:demo",
    "cli": "tsx src/cli.ts",
    "export-openapi": "tsx src/cli.ts export-openapi"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.5.1",
    "@node-rs/argon2": "^2.0.2",
    "@sinclair/typebox": "^0.34.33",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "dependency-cruiser": "^16.10.1",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "fast-check": "^4.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
