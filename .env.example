# ── Runtime ────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
PORT=8080
LOG_LEVEL=info

# ── Database (Render / Supabase PostgreSQL) ────────────────
# Render internal DB URL, or Supabase pooled connection string:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/waste

# ── Secrets (REQUIRED in production — app fails fast if weak/missing) ──
# openssl rand -base64 48
JWT_SECRET_KEY=
JWT_KEY_ID=waste-jwt-2026-01
IDENTITY_PEPPER=
IDENTITY_PEPPER_KID=waste-pepper-2026-01

# ── Token lifetimes ────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ── Web / CORS ─────────────────────────────────────────────
# Comma separated explicit origins. Leave EMPTY when the SPA is served
# from the same Fastify service (production on Render) — no CORS needed.
CORS_ORIGINS=

# ── Proxy & abuse limits ───────────────────────────────────
# Reverse-proxy hops to trust when deriving the client IP (rate limits, audit
# log). 0 = none (local dev). Behind Render use 1 and VERIFY the `ip` column
# of auth_events shows real client addresses: too low shares one rate-limit
# bucket among ALL users; too high lets clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Per-IP/minute cap on login, register, change-password, accept-invitation
# (refresh allows 6x this).
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Feature flags ──────────────────────────────────────────
ALLOW_CITIZEN_SELF_REGISTRATION=true
# MUST be false outside development — production boot fails otherwise.
DEMO_MODE=false
